#include<stdio.h>

int main(){
	int a[100][100],b[100][100];
int m,n,p,r;
	scanf("%d %d",&m,&n);
	int i,j;

	for(i=0;i<m;i++){
		for(j=0;j<n;j++){
			scanf("%d",&a[i][j]);
		}
	}
	scanf("%d %d",&r,&p);
	if(n!=r){
		printf("Invalid input\n");
		return 0;
	}
	for(i=0;i<r;i++){
		for(j=0;j<p;j++){
			scanf("%d",&b[i][j]);
		}
	}
	int c[100][100]={0};

	for(i=0;i<m;i++){
		for(j=0;j<p;j++){
			for(int k=0;k<n;k++){
				c[i][j]+=a[i][k]*b[k][j];
			}
		}
	}

	for(i=0;i<m;i++){
		for(j=0;j<p;j++){
			printf("%d ",c[i][j]);
			if(j<p-1){
				printf("");
			}
		}
		printf("\n");
	}
}
